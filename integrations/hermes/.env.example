# 复制为 Hermes finance profile 目录下的 .env，不要提交到仓库
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# 随便生成一串长随机字符，同一个值也要填进工作台本地服务的 HERMES_API_KEY
API_SERVER_KEY=换成一串长随机字符

# 与工作台本地服务用同一个数据目录（Windows 默认 %APPDATA%\FinanceWorkbench）
FW_DATA_DIR=C:\Users\你的用户名\AppData\Roaming\FinanceWorkbench
